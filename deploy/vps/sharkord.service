[Unit]
Description=Sharkord voice and text chat
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=sharkord
Group=sharkord
WorkingDirectory=/var/lib/sharkord
StateDirectory=sharkord
StateDirectoryMode=0700
EnvironmentFile=/etc/sharkord.env
ExecStart=/opt/sharkord/current/sharkord
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
MemoryHigh=512M
MemoryMax=768M
MemorySwapMax=256M
OOMScoreAdjust=500
OOMPolicy=kill
CPUWeight=50
IOWeight=50
UMask=0077
LimitCORE=0
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
ReadWritePaths=/var/lib/sharkord

[Install]
WantedBy=multi-user.target

<Window x:Class="Sharkord.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Sharkord" Width="1180" Height="800"
        MinWidth="780" MinHeight="580" Loaded="WindowLoaded" Closing="WindowClosing">
  <DockPanel>
    <Border DockPanel.Dock="Top" Padding="10" BorderBrush="#DDD" BorderThickness="0,0,0,1" Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button Content="Подключиться" x:Name="ConnectButton" Click="ConnectClick" IsDefault="True"/>
          <Button Content="↻" Click="ReloadClick" ToolTip="Перезагрузить (Ctrl+R)"/>
          <Button Content="В браузере" Click="BrowserClick"/>
          <Button Content="Обновления" x:Name="UpdateButton" Click="UpdateClick"/>
          <Button Content="Выход" Click="ExitClick"/>
        </StackPanel>
        <ComboBox x:Name="ServerBox" IsEditable="True" VerticalContentAlignment="Center" Padding="8,4"
                  MinWidth="180" ToolTip="HTTPS-адрес сервера, включая подпуть"/>
      </DockPanel>
    </Border>
    <TextBlock DockPanel.Dock="Bottom" x:Name="StatusText" Padding="12,5" Text="Введите адрес сервера Sharkord и нажмите «Подключиться»."/>
    <Grid x:Name="BrowserHolder">
      <StackPanel x:Name="Welcome" VerticalAlignment="Center" HorizontalAlignment="Center">
        <TextBlock Text="Sharkord" FontSize="36" FontWeight="Bold" HorizontalAlignment="Center"/>
        <TextBlock Text="Голос, чат и картинки на вашем сервере" Margin="0,15,0,0"/>
      </StackPanel>
    </Grid>
  </DockPanel>
</Window>

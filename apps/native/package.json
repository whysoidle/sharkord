{
  "name": "@sharkord/native",
  "version": "0.1.5",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun run scripts/build-assets.ts",
    "build:macos": "bun run scripts/build-macos.ts",
    "check-types": "tsc --noEmit",
    "format": "prettier --write 'src/**/*.ts' 'scripts/**/*.ts' --config ../client/.prettierrc.json",
    "format:check": "prettier --check 'src/**/*.ts' 'scripts/**/*.ts' --config ../client/.prettierrc.json"
  },
  "dependencies": {
    "animejs": "^4.3.0",
    "motion": "^12.23.24"
  },
  "devDependencies": {
    "typescript": "~5.8.3",
    "@types/bun": "1.3.14",
    "prettier": "^3.5.3",
    "prettier-plugin-organize-imports": "^4.1.0"
  }
}
